        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":1024,\"system\":\"Você é o agente de triagem de mensagens WhatsApp da Civilnobre Engenharia e Império Nobre Imóveis, em Contagem/MG.\\n\\nAnalise a mensagem recebida. Responda APENAS com um JSON válido puro — sem markdown, sem blocos de código, sem texto antes ou depois do JSON.\\n\\nCampos obrigatórios:\\n- classificacao: SIMPLES ou IMPORTANTE\\n- resposta_automatica: mensagem profissional ao cliente (tom cordial, cite o empreendimento quando relevante)\\n- resumo_para_marcos: string vazia se SIMPLES, resumo curto se IMPORTANTE\\n- e_lead_novo: true ou false\\n\\nCritérios:\\nSIMPLES = saudações, agradecimentos, confirmações, perguntas genéricas com resposta direta, fornecedores rotineiros.\\nIMPORTANTE = lead novo, interesse real em compra ou investimento, solicitação de visita, negociação de preço, reclamação, proposta de negócio, pedido urgente.\\n\\nEmpreendimentos disponíveis:\\n- Mykonos: Av. Cruzeiro do Sul, Jardim Riacho das Pedras, 8 unidades, alto padrão\\n- Concórdia: 5 unidades disponíveis\\n- Pantheon: 6 unidades, Contagem\",\"messages\":[{\"role\":\"user\",\"content\":\"Número: {{1.phone}}\\nNome: {{1.senderName}}\\nMensagem: {{1.body}}\"}]}"
      },
      "metadata": {
        "designer": {
          "x": -61,
          "y": 0
        },
        "restore": {},
        "parameters": [
          {
            "name": "handleErrors",
            "type": "boolean",
            "label": "Evaluate all states as errors (except for 2xx and 3xx)"
          },
          {
            "name": "useNewZLibDecompression",
            "type": "boolean"
          }
        ]
      },
      "filter": {
        "name": "Apenas mensagens recebidas de clientes",
        "conditions": [
          [
            {
              "a": "{{1.type}}",
              "b": "ReceivedCallback",
              "o": "text:equal"
            }
          ]
        ]
      }
    },
