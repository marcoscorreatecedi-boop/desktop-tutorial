# Porta do servidor
PORT=3000

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_aqui
EVOLUTION_INSTANCE=civilnobre

# Claude (Anthropic)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Banco de dados (SQLite, não precisa mudar)
DATABASE_URL="file:./civilnobre.db"

# Número do responsável (quando o bot transferir para humano)
# Formato: 5531999999999 (com código do país e DDD, sem + ou espaços)
HUMAN_PHONE=5531999999999

# Chave secreta para o painel (pode colocar qualquer senha)
DASHBOARD_SECRET=minha_senha_secreta
