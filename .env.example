# Porta em que o servidor vai escutar
PORT=3000

# Token que você escolhe para validar o webhook na Meta (qualquer string secreta)
WHATSAPP_VERIFY_TOKEN=escolha-um-token-secreto

# Token de acesso gerado no Meta for Developers (App > WhatsApp > API Setup)
WHATSAPP_TOKEN=seu-token-de-acesso-da-meta

# Phone Number ID do número de WhatsApp Business (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-de-telefone

# Versão da Graph API usada para enviar mensagens
WHATSAPP_API_VERSION=v20.0

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sua-chave-da-api-anthropic

# Modelo Claude usado para gerar as respostas
CLAUDE_MODEL=claude-sonnet-4-6
